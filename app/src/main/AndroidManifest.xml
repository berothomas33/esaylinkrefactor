<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for every OkHttp/Retrofit call this app makes — onboarding, EMV param
         download, and the cacore/exchange + cacore/sale sale flow. Without it, any network
         call throws SecurityException: Permission denied (missing INTERNET permission?)
         at DNS lookup, not at the HTTP layer, so it looks like a connectivity issue rather
         than a missing manifest permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EmvEnhanceApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_manage"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmvEnhanceRefactor">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.AmountActivity"
            android:exported="false" />
    </application>
</manifest>
