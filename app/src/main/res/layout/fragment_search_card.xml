<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Live EMV-step feed — updated from MainViewModel#getEmvStep as steps arrive. -->
        <TextView
            android:id="@+id/emvStepBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:gravity="center"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="@string/search_card_waiting"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDDDDD"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_amount_due"
                        android:textColor="#888888"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/amountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText"
                        tools:text="100.00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Entry-method choices — hidden once a card is actually detected (any mode), since
                 offering "insert / swipe / tap / manual" after one is already chosen is misleading. -->
            <LinearLayout
                android:id="@+id/methodSelectionGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/search_card_subtitle"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/rowMagstripe"
                    layout="@layout/item_entry_method" />

                <include
                    android:id="@+id/rowChip"
                    layout="@layout/item_entry_method" />

                <include
                    android:id="@+id/rowContactless"
                    layout="@layout/item_entry_method" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManualEntry"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_manual_entry"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/action_manual_entry"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_keyboard"
                    app:iconGravity="textEnd"
                    app:iconPadding="10dp"
                    app:iconSize="22dp"
                    app:iconTint="@android:color/white"
                    app:rippleColor="#33FFFFFF" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSearch"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_cancel" />

            <!-- Shown once the transaction is APPROVED or DECLINED — chip/contactless only,
                 mag/manual have no ICC session to report on. -->
            <LinearLayout
                android:id="@+id/resultGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/result_details_title"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <include
                            android:id="@+id/rowPan"
                            layout="@layout/item_kv_row" />

                        <include
                            android:id="@+id/rowTvr"
                            layout="@layout/item_kv_row" />

                        <include
                            android:id="@+id/rowTacDenial"
                            layout="@layout/item_kv_row" />

                        <include
                            android:id="@+id/rowIacDenial"
                            layout="@layout/item_kv_row" />

                        <include
                            android:id="@+id/rowIccData"
                            layout="@layout/item_kv_row" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/chkApduLog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/action_log_apdu" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrintResult"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/action_print_result" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
