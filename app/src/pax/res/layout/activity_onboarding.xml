<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartOnboarding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_start_onboarding" />

            <ProgressBar
                android:id="@+id/onboardingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/onboardingStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/placeholder"
            android:textSize="13sp" />

        <!-- mToken: shows the fixed build value until one is saved here; the saved value is
             what orchestration/sale sends (HostSettings). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mtoken_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mTokenSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/mTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F4F4F4"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="@string/mtoken_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="4"
            android:padding="8dp"
            android:textColor="#000000"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMToken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/action_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetMToken"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_reset_default" />
        </LinearLayout>

        <!-- Every header the terminal sends, read-only but selectable. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/headers_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F4F4F4"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#000000"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>

</ScrollView>
